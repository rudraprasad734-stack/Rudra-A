PORT=3001

# The domain allowed to call this API (your frontend's address).
# For local testing, use: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# The address of your PocketBase database (see apps/pocketbase).
# For local testing, use: http://localhost:8090
POCKETBASE_HOST=http://localhost:8090

# The superuser (admin) account this API logs in as to talk to PocketBase.
# Create this account the first time you run PocketBase, then put the same email/password here.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
