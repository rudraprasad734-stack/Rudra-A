# Copy this file to .env (or set these as real environment variables in your
# hosting platform) before running PocketBase. Every value below is read by
# either the pocketbase binary itself or a pb_hooks/*.js file at startup.

# ---------------------------------------------------------------------------
# Superuser bootstrap (apps/pocketbase/pb_migrations/1764579159_create_superuser.js)
# Only used the very first time PocketBase starts against an empty database.
# ---------------------------------------------------------------------------
PB_SUPERUSER_EMAIL=you@example.in
PB_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# Outgoing mail (apps/pocketbase/pb_hooks/smtp-from-env.pb.js)
#
# REQUIRED for any login to work: citizens sign in with a passwordless email
# OTP, and the President must complete a second email-OTP step even after a
# correct password. Without a working SMTP_HOST + SMTP_SENDER_ADDRESS, those
# codes are never delivered and every OTP-based login silently fails (the API
# still reports success, by design, to avoid leaking which emails exist).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_SENDER_ADDRESS=no-reply@yourdomain.in
# Optional — defaults shown:
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH_METHOD=
# SMTP_TLS=true
# SMTP_SENDER_NAME=IAYO
