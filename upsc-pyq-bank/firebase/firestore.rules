rules_version = '2';
// UPSC Companion cloud sync.
// Each signed-in student can read and write ONLY their own documents:
//   users/{their uid}/data/{docId}
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'device'])
                            && request.resource.data.json is string
                            && request.resource.data.json.size() < 950000
                            && request.resource.data.updatedAt is number;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
